// Deskly database schema (production backbone — slice 1).
//
// Normalized: tickets reference users/categories by FK; the repository JOINs to
// produce the display names the API/UI expect. Enums mirror src/shared/domain.ts
// EXACTLY. ticket_status_history is the SLA source of truth, written on every
// status change. Attachment / Comment / Notification / AuditLog / RefreshToken
// are intentionally deferred to later milestones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// What a ticket can be stored as. Three values: the work is waiting (`new`),
/// finished and waiting on the requester (`pending`), or over (`closed`).
///
/// "In Progress" is deliberately absent — it is `new` with an assignee, derived
/// on read by `displayStatus`. Keeping it out of the column is what stops the
/// two facts disagreeing: a status of its own could say nobody is on a ticket
/// that has an assignee, or claim work on one that has none.
enum TicketStatus {
  new
  pending
  closed
  /// Withdrawn by the person who raised it, before the desk moved it. Its own
  /// value rather than a flavour of `closed`: closed is work that was done,
  /// cancelled is work that never happened, and merging them would inflate the
  /// closed archive and every desk figure with tickets nobody worked. See
  /// shared/ticket-status.ts.
  cancelled
}

/// The vocabulary `ticket_status_history` was written with, which is wider than
/// what can be stored today: rows from before the three-value model name `open`,
/// `in_progress` and `resolved`. That table is append-only and the SLA source of
/// truth, so its words are left as they were rather than rewritten into
/// something nobody chose — a `new → new` transition would be a lie about what
/// happened. Readers map them with `displayStatus`.
enum TicketStatusRecord {
  new
  open
  in_progress
  pending
  resolved
  closed
  cancelled
}

enum Priority {
  low
  medium
  high
  critical
}

// Three tiers, highest first. `super_admin` covers what used to be split between
// manager and admin; which customers one reaches is decided by `users.customerId`
// (null = the whole platform), NOT by the role name — collapsing the two roles
// without that would have handed every former manager every other tenant's data.
enum Role {
  super_admin
  admin
  user
}

/// Where an account is in its life, which is a different question from what it
/// may do (`Role`) and from whether it is still employed (`User.isActive`).
///
/// Deliberately NOT folded into `isActive`. That flag already means one specific
/// thing — the person has left — and it is what routing, assignment and the
/// session sweep read. An account waiting to be approved has never been used,
/// which is not the same fact, and a report that cannot tell "gone" from "not
/// yet let in" is a report that miscounts the desk twice over.
///
/// `pending` is the state self-registration lands in, and it sees NOTHING: the
/// gate is in `requireAuth`, so every route is covered at once rather than each
/// one remembering. `rejected` is kept rather than deleted because the row is
/// evidence somebody applied and a person said no; `Ticket.requesterId` is
/// RESTRICT anyway, so deleting is not on offer once they have raised anything.
enum UserStatus {
  pending
  active
  suspended
  rejected
}

// Configuration-item kinds for the asset registry. Deliberately coarse — this is
// a help-desk asset list, not a full CMDB.
enum AssetKind {
  laptop
  desktop
  phone
  tablet
  printer
  server
  network
  software
  other
}

enum AssetStatus {
  active
  in_repair
  retired
}

// Problem-management lifecycle (ITIL-flavoured, deliberately short).
enum ProblemStatus {
  investigating
  known_error
  resolved
  closed
}

// The languages outbound mail and the UI are written in. Kept as an enum rather
// than a free string because it selects a template set: an unknown value would
// mean "no template", and the failure would be a mail nobody can read.
enum Language {
  en
  th
}

/// Lifecycle of one queued email. `pending` is the only state the sweep picks
/// up; the other three are terminal.
///
/// `suppressed` is deliberately distinct from `failed`: it records a mail we
/// DECIDED not to send (no usable address, the event switched off, a recipient
/// rule) as opposed to one that was attempted and did not arrive. Collapsing the
/// two would make "nobody was told" indistinguishable from "the provider was
/// down", which is exactly the question the Activity log has to answer.
enum EmailOutboxStatus {
  pending
  sent
  failed
  suppressed
}

// Where a thread message came from. `web` = posted in the app, `email` = arrived
// by mail and was threaded onto the ticket. Drives the channel badge in the UI;
// the thread itself is a single ordered list regardless of channel.
enum CommentChannel {
  web
  email
}

/// Which surface a TICKET arrived through. Deliberately a separate enum from
/// `CommentChannel` above, which is about one message: a ticket raised in the app
/// can carry messages that arrived by mail, so collapsing the two would make the
/// ticket's own origin unanswerable the moment somebody replies.
///
/// `web_intake` is the public form (`web-intake` in the design document — a
/// hyphen is not a legal enum value here, and the wire format is not what the
/// column stores). It is the only value written today; see `Ticket.channel`.
enum TicketChannel {
  /// Raised by a signed-in person in the app.
  web
  /// Arrived as mail and became a ticket (`emailService.ingest`).
  email
  /// Loaded from a spreadsheet.
  csv_import
  /// Submitted through the public intake form by somebody with no account.
  web_intake
}

/// What became of one public-form submission.
///
/// `linked` and `triage` both produced a real ticket and differ only in whether
/// the sender's email domain named a customer we know. `spam` is a submission the
/// honeypot caught: it is kept, deliberately, because the only way to tell a
/// tuned honeypot from a broken one is to look at what it caught — but it has no
/// ticket and nobody was mailed.
enum IntakeStatus {
  linked
  triage
  spam
}

/// Where a file stands with the virus scanner.
///
/// Four states from the design document, and a fifth that is the absence of a
/// row's answer: NULL means the file was never subject to scanning. That covers
/// every attachment uploaded in the app by a signed-in person and every row
/// written before this column existed, and it is not the same fact as `clean`,
/// which is a scanner saying so. A reader that needs "safe to hand over" must
/// treat `pending`, `infected` and `error` as no and the other two as yes.
enum AttachmentScanStatus {
  pending
  clean
  infected
  error
}

/// Which backend holds a stored object.
///
/// Recorded per row rather than read from `STORAGE_DRIVER` at download time,
/// which is what the app does today: flipping that variable from `local` to `s3`
/// currently makes every file already on disk unreadable, because the reader
/// looks for all of them in the new place. Nullable for the rows that predate
/// this, which the reader falls back to the env driver for — exactly its present
/// behaviour, so nothing changes for them.
enum StorageProvider {
  disk
  s3
}

// A tenant organization. The top-level isolation boundary: staff see everything
// within their own customer (across departments) but nothing of other customers;
// platform admins (customerId = null) span all customers.
model Customer {
  id             Int                   @id @default(autoincrement())
  name           String                @unique
  users          User[]
  teams          Team[]
  tickets        Ticket[]
  assets         Asset[]
  problems       Problem[]
  projects       Project[]
  settings       NotificationSettings?
  /// This customer's categories. Every category belongs to one tenant now —
  /// there are no shared rows left; what crosses tenants is `Category.code`.
  categories     Category[]
  /// Staff granted reach INTO this customer without belonging to it.
  reachGrants    UserCustomer[]
  /// Email domains that identify this tenant, for the public intake form's
  /// customer match (`customerMatch.ts`): a submission whose `businessEmail`
  /// domain appears here is linked to this customer automatically; no match
  /// leaves the ticket in the system tenant below, for a human to triage.
  ///
  /// A plain array rather than a join table — a handful of domains per tenant,
  /// looked up by exact match, with no need for the domain to carry its own
  /// attributes. Lowercase, no leading `@`; the matcher normalises what it reads
  /// out of `businessEmail` to the same shape before comparing.
  domains        String[]              @default([])
  /// The one tenant that is not a real customer: where an intake submission
  /// lands when its email domain matches nobody, and the customer a ticket needs
  /// even though no tenant claims it — see the system user on `User` below and
  /// backend/CLAUDE.md. Exactly one row should ever carry this; application code
  /// filters it out of the customer picker and management screens by this flag,
  /// never by name or id, so renaming it cannot make it reappear as a real tenant.
  isSystemTenant Boolean               @default(false) @map("is_system_tenant")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  /// Archived, not deleted. A tenant is never removed from disk: its id is on
  /// every ticket, audit row and project it ever had, and a hard delete would
  /// either take those with it or strand them. Refused while the customer still
  /// has live projects, tickets or users — see `customerService.archive`, which
  /// says what to move first rather than deciding for you.
  ///
  /// Filtered out by `customerScopeWhere`, so an archived tenant leaves every
  /// picker at once, the way `projectScopeWhere` handles a deleted project.
  deletedAt   DateTime? @map("deleted_at")
  /// Who archived it. Nullable because it is only set then, and named so it
  /// cannot be confused with the membership relation above.
  deletedById Int?      @map("deleted_by_id")
  deletedBy   User?     @relation("CustomerDeletedBy", fields: [deletedById], references: [id])

  // Names stay unique across ARCHIVED rows too, unlike projects. A tenant name
  // is what appears on an invoice and in an audit trail; letting a new customer
  // take an archived one's name would make two different companies
  // indistinguishable in the history. Reviving the old row is the right move
  // there, and is why archiving is reversible.
  @@map("customers")
}

/// A member of staff may WORK a customer they do not BELONG to.
///
/// `users.customer_id` answers "which company is this person at" and stays a
/// single value, because it is what a ticket they raise is filed under — a
/// ticket belongs to one customer and always will. This table answers a
/// different question: which customers may this person see into. One agent
/// covering three client companies needs the second answer to be a list while
/// the first stays one value, and conflating them is what would break filing.
///
/// Absent rows are not a missing configuration. A user with no row here reaches
/// exactly their own customer, which is what every user did before this table
/// existed — so it starts empty and nothing changes until someone is explicitly
/// granted more. That is also why there is nothing to backfill.
///
/// Granting is a cross-tenant act and is reserved to a platform-wide
/// super_admin (see `mayGrantReach`): an admin who could widen their own reach
/// would be their own approver.
model UserCustomer {
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([userId, customerId])
  // Reach is read on every sign-in and token refresh, by user.
  @@index([userId])
  // "Who can see into this customer" — the grant list on a customer's page.
  @@index([customerId])
  @@map("user_customers")
}

/// One customer's notification policy: which events are mailed, how often, and
/// when the SLA starts warning.
///
/// Per tenant rather than per platform, because these are decisions about how a
/// desk talks to its own people — switching off SLA alerts for customer A must
/// not switch them off for customer B.
///
/// A customer with no row here is not misconfigured, it is UNCONFIGURED: every
/// reader falls back to the deployment's own defaults (`env.ticketEmail`,
/// `SLA_WARN_MS`). That is why the row is created on first write rather than
/// seeded for everyone — an absent row and a row holding the defaults mean the
/// same thing, and only one of them has to be kept in step with a changing
/// default.
model NotificationSettings {
  id         Int      @id @default(autoincrement())
  customerId Int      @unique @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Event types NOT to send, e.g. `["ticket.sla_warning"]`. A DENY list, so an
  /// event added to the catalogue later works for every existing customer
  /// without anyone editing their settings — only turning one OFF is a decision
  /// somebody has to make.
  disabledEvents String[] @map("disabled_events")

  /// Anti-spam: at most this many mails to one person about one ticket inside
  /// the window; anything beyond collapses into a single summary.
  ratePerTicket Int @map("rate_per_ticket")
  rateWindowMs  Int @map("rate_window_ms")

  /// How long before `due_at` a ticket starts reading as "due soon".
  ///
  /// ONE value, deliberately: it drives both the badge a person sees on the list
  /// and the alert the sweep pushes, which is the property the SLA module was
  /// built around — what the UI calls at-risk is exactly what raises an alert,
  /// and they cannot drift apart. Changing this therefore moves the colours on
  /// screen as well as the emails, which is the intended and agreed behaviour.
  slaWarnMs Int @map("sla_warn_ms")

  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

// A grouping BELOW the customer — the unit a caseworker is responsible for.
//
// Purely a ROUTING dimension: it decides who a new ticket lands on, and never
// who may see what. Visibility remains the customer boundary enforced in
// ticketScopeWhere, so putting a ticket in a project can never hide it from that
// customer's other agents or managers. Same stance as Team/department.
//
// `owner` is the caseworker; `backupOwner` stands in when the owner is
// unavailable (see User.availableForAssignment) — without it, "the owner is out"
// would silently mean "nobody is assigned".
model Project {
  id            Int       @id @default(autoincrement())
  name          String
  /// What this project IS, in the words of whoever set it up — scope, contacts,
  /// the standing arrangement with the customer. Markdown, rendered on the
  /// project's own page.
  ///
  /// Nullable and staying that way: the 30 projects that already exist were
  /// created as routing targets and have no description anybody could invent for
  /// them, and a project is still a valid routing target with nothing written
  /// about it. Requiring it here would make the column a lie for every row
  /// predating it.
  description   String?
  customerId    Int       @map("customer_id")
  customer      Customer  @relation(fields: [customerId], references: [id])
  ownerId       Int?      @map("owner_id")
  owner         User?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  backupOwnerId Int?      @map("backup_owner_id")
  backupOwner   User?     @relation("ProjectBackupOwner", fields: [backupOwnerId], references: [id])
  members       User[]    @relation("ProjectMember")
  /// Tickets filed under this project. Routing AND grouping, never visibility.
  tickets       Ticket[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // Soft delete, super-admin only, and refused while anyone is still a member.
  //
  // The row stays on disk because the audit trail points at it by id and a
  // deleted routing target is still part of how past work was routed. Filtered
  // out by `projectScopeWhere`, which folds `deletedAt: null` in the same way
  // `ticketScopeWhere` does — one clause every project read already goes
  // through, rather than a condition repeated at each call site.
  deletedAt     DateTime? @map("deleted_at")
  // Who deleted it. Nullable because it is only set on deletion, and the
  // relation is named so it cannot be confused with owner/backupOwner above.
  deletedById   Int?      @map("deleted_by_id")
  deletedBy     User?     @relation("ProjectDeletedBy", fields: [deletedById], references: [id])

  // Names are unique per customer AMONG LIVE PROJECTS, not globally: two
  // customers may each run a "Migration", and archiving one frees the name for
  // the next. That last part is a partial unique index
  // (`WHERE deleted_at IS NULL`) which Prisma cannot express, so it lives in
  // the migration as raw SQL and is NOT declared here — see the "Database
  // objects Prisma does not know about" note in backend/CLAUDE.md, and
  // constraints.integration.test.ts, which fails if it is ever dropped.
  //
  // The trade, accepted deliberately: two archived projects may now share a
  // name, so in the audit trail only the id tells them apart.
  @@unique([id, customerId])
  @@index([customerId])
  @@map("projects")
}

model Team {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  department String
  customerId Int?       @map("customer_id")
  customer   Customer?  @relation(fields: [customerId], references: [id])
  members    User[]
  categories Category[] // categories that default-route to this team
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("teams")
}

model User {
  id                     Int                   @id @default(autoincrement())
  name                   String
  email                  String                @unique
  role                   Role
  /// Where this account is in its life — see UserStatus.
  ///
  /// Required, and deliberately WITHOUT a default. A default of `active` would
  /// mean a create path that forgets to name a status mints a working account,
  /// which is the one mistake self-registration must never make; with none, the
  /// compiler asks every caller. Rows that predate the column were backfilled to
  /// `active`, which is what all 16 of them already were.
  status                 UserStatus
  /// When this address was proven to belong to whoever is using it. Null = never.
  ///
  /// A timestamp rather than a boolean, for the same reason `resolvedAt` is one:
  /// "when" answers "whether" as well, and support asking "did they ever confirm,
  /// and when" is a question a boolean throws away. Accounts that predate
  /// self-registration are stamped at migration time — they were created by a
  /// person who already knew who they were, so demanding they re-prove it would
  /// lock out the entire existing desk to enforce a rule none of them broke.
  emailVerifiedAt        DateTime?             @map("email_verified_at")
  /// Set when the password on this account was chosen by somebody ELSE — an
  /// administrator creating the account hands over a password the person did not
  /// pick and which was spoken aloud or typed into a chat to reach them. Until
  /// they replace it, `requireAuth` refuses every route but the one that
  /// replaces it, so the borrowed password buys nothing beyond its own removal.
  ///
  /// A timestamp rather than a flag so the row says WHEN the account was handed
  /// over, which is the question asked of an account that has been sitting on a
  /// temporary password for a month. Cleared — back to null — by the change.
  ///
  /// Self-registration never sets it: that person chose their own password, and
  /// nobody else ever knew it.
  mustChangePasswordAt   DateTime?             @map("must_change_password_at")
  teamId                 Int?                  @map("team_id")
  team                   Team?                 @relation(fields: [teamId], references: [id])
  // The customer this person BELONGS to — their home tenant. Null = platform
  // staff. Single-valued on purpose: it is what a ticket they raise is filed
  // under, and a ticket has one customer. Reach — which customers they may see
  // INTO — is a separate, wider question answered by `reachGrants` below.
  customerId             Int?                  @map("customer_id")
  customer               Customer?             @relation(fields: [customerId], references: [id])
  /// Customers this person may work BEYOND their own. See UserCustomer.
  reachGrants            UserCustomer[]
  // Project this user's tickets route through. Routing only — never visibility.
  projectId              Int?                  @map("project_id")
  project                Project?              @relation("ProjectMember", fields: [projectId], references: [id])
  // Whether new work may be routed to this person. The "ผู้ดูแลไม่สะดวก" switch:
  // false makes project routing skip them in favour of the backup owner, and is
  // what a manager flips before handing off an existing queue. It does NOT
  // restrict what they can see or do — an unavailable agent still works their
  // open tickets.
  availableForAssignment Boolean               @default(true) @map("available_for_assignment")
  // Whether this account may be used at all. False = the person has left: they
  // cannot sign in, an existing session dies at its next refresh, and no new work
  // routes to them.
  //
  // Distinct from `availableForAssignment` above, which is a rota switch — an
  // unavailable agent is at lunch and still works their queue. This one is the
  // door. Deactivating replaces deleting, which the schema cannot offer anyway:
  // `Ticket.requesterId` is RESTRICT, so a person who ever raised a ticket can
  // never be removed without erasing their history with them.
  isActive               Boolean               @default(true) @map("is_active")
  // The `requesterId` for a ticket nobody signed in to raise — public intake
  // submissions, whose sender has no Deskly account. `Ticket.requesterId` is
  // required and RESTRICT, so a ticket needs a real row here rather than a null;
  // this flag is what tells the rest of the app that row is a placeholder rather
  // than a person, so notifications addressed to the requester and the
  // requester-only actions (cancel, confirm, reject) route around it instead of
  // treating a fixed shared account as if one specific person were signed into
  // it. `isActive` stays true and `passwordHash` stays null, which already keeps
  // it from ever signing in — this flag is about what OTHER code does with it,
  // not about locking the door twice.
  isSystemAccount        Boolean               @default(false) @map("is_system_account")
  // Which language this person has CHOSEN to be written to in.
  //
  // Nullable, and deliberately without a default: null means "has never said",
  // which is a different fact from "chose Thai" and the two must not be
  // conflated. Each reader supplies its own fallback for null, and they do not
  // agree — mail falls back to Thai (`DEFAULT_LANG`, the desk's correspondents
  // are Thai-speaking unless they say otherwise) while the web app falls back to
  // its own English default. A column defaulting to `th` would have quietly
  // reversed that second one, flipping the UI to Thai for every existing account
  // on their next sign-in, having never asked any of them.
  language               Language?
  ownedProjects          Project[]             @relation("ProjectOwner")
  backupForProjects      Project[]             @relation("ProjectBackupOwner")
  deletedProjects        Project[]             @relation("ProjectDeletedBy")
  archivedCustomers      Customer[]            @relation("CustomerDeletedBy")
  passwordHash           String?               @map("password_hash") // filled by the auth milestone
  /// Single-use tokens mailed to this person — password resets and address
  /// verifications. See UserToken.
  userTokens             UserToken[]
  requestedTickets       Ticket[]              @relation("TicketRequester")
  assignedTickets        Ticket[]              @relation("TicketAssignee")
  statusChanges          TicketStatusHistory[]
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  grantedPermissions     RolePermission[]      @relation("RolePermissionGrantedBy")
  comments               Comment[]
  notifications          Notification[]
  attachments            Attachment[]
  ticketReads            TicketRead[]
  queuedEmails           EmailOutbox[]
  // Tickets where this user is an *affected* party rather than the requester.
  affectedTickets        TicketAffectedUser[]
  ownedAssets            Asset[]               @relation("AssetOwner")
  createdProblems        Problem[]             @relation("ProblemCreatedBy")
  kbArticles             KbArticle[]           @relation("KbAuthor")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  @@map("users")
}

// Rotating refresh tokens. One row per issued token; the raw value is never
// stored (only its SHA-256 hash). `familyId` groups a login session's rotation
// chain — presenting an already-revoked token (reuse) revokes the whole family.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// What a one-shot token mailed to a person is FOR.
///
/// One table for both, rather than two nearly identical ones, because the shape
/// is genuinely the same — a hashed secret, an expiry, and a single use — and
/// the only thing that differs is the TTL, which is policy and lives in config,
/// not structure. Splitting them would duplicate the sweep, the hashing and the
/// single-use guard three times over to express one enum value.
enum UserTokenPurpose {
  password_reset
  email_verification
}

/// A single-use secret mailed to a person: "reset your password", "confirm this
/// address".
///
/// Stores the SHA-256 HASH, never the token — the same rule `RefreshToken`
/// follows, and for the same reason: a leaked database must not hand over
/// working reset links for every account in it. The raw value exists only in the
/// email and in the request that redeems it.
///
/// `usedAt` rather than deleting the row on redemption. A consumed token is the
/// evidence that a reset actually happened and when, which is exactly what
/// someone investigating a compromised account needs; deleting it would leave
/// the successful reset as the only unlogged step in the chain.
model UserToken {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  /// When it was redeemed. Null = still live. Checked on every redemption, so a
  /// token works exactly once however fast the second attempt arrives.
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  // "Every live token this person holds" — read when issuing a new one (the
  // previous ones are invalidated) and when a reset succeeds.
  @@index([userId, purpose])
  @@map("user_tokens")
}

/// What a ticket is about. Either the platform's own, or one customer's.
///
/// `customerId` is nullable and null means SHARED — available to every tenant.
/// That is not a placeholder for un-migrated data: the six categories the desk
/// started with are genuinely everyone's, 292 tickets point at them, and giving
/// each customer a private copy would have meant rewriting every one of those
/// rows to say something no one had decided. So null is a real state with a
/// meaning, and a customer's own categories sit alongside it rather than
/// replacing it. A picker shows the shared ones plus that customer's.
model Category {
  id            Int      @id @default(autoincrement())
  name          String
  /// The stable identity behind the name, shared across tenants.
  ///
  /// Once every customer owns their own categories, Acme's "Network" and
  /// Globex's "Network" are two different rows, and any report that groups by
  /// category id gets two lines where the desk means one. This is what such a
  /// report groups by instead: both rows carry `NETWORK`, so the grouping
  /// survives the split that made the rows separate in the first place.
  ///
  /// A code, not the name, deliberately — a customer may rename their copy to
  /// "Networking" or translate it into Thai without silently splitting a report
  /// line in two. Renaming is a display decision; this is not.
  ///
  /// Required. Existing rows were backfilled from their own names, which is
  /// exactly right for the six the desk started with: they ARE the canonical
  /// set, so their names are the canonical codes.
  code          String
  /// The tenant this category belongs to. Every category belongs to exactly one.
  ///
  /// It used to be nullable, where null meant SHARED WITH EVERYONE, and that
  /// state is gone: it made "which customer does this row belong to" unanswerable
  /// for the row a ticket points at, so the database could not prove that a
  /// ticket's category and its project name the same tenant. It can now — see the
  /// composite key below.
  ///
  /// What replaced the shared row is `code`: the six categories the desk started
  /// with became one copy per customer carrying the same code, so a report still
  /// groups them into one line while each tenant owns, renames and routes its own.
  customerId    Int      @map("customer_id")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  defaultTeamId Int?     @map("default_team_id") // auto-assignment target
  defaultTeam   Team?    @relation(fields: [defaultTeamId], references: [id])
  tickets       Ticket[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Unique per owner, and now the whole story: with `customerId` required there
  // are no NULLs left for Postgres to treat as distinct, so the partial index
  // that used to cover the shared rows is dropped by the same migration.
  @@unique([customerId, name])
  // One row per code per tenant. This is what makes the code a usable grouping
  // key: two rows with the same code under one customer would double-count that
  // customer in every report that groups by it.
  @@unique([customerId, code])
  // The key the composite foreign key on `tickets` references. Redundant on its
  // own — `id` is already the primary key — and that is exactly its job, the
  // same way `projects` carries one.
  @@unique([id, customerId])
  @@index([customerId])
  @@map("categories")
}

model Ticket {
  id             Int                   @id @default(autoincrement())
  /// Public reference for a ticket raised through the public intake form, in the
  /// shape `BF-YYYYMMDD-####` (the prefix comes from `TICKET_PREFIX`).
  ///
  /// NOT the identifier. `id` is, everywhere — in every URL, in `[Deskly #123]`
  /// on outbound mail, and in the `#123` the web app prints. This column exists
  /// because an external person who has no account and no link needs something to
  /// quote back, and a bare integer from a database sequence is both unmemorable
  /// and a running total of how much work the desk has ever had.
  ///
  /// Nullable, and staying that way: it is issued by the intake channel alone, so
  /// every ticket raised in the app, by mail or from a spreadsheet has none and
  /// must still open. Nulls do not collide in Postgres, which is what lets this
  /// be a nullable unique rather than a required one — the same shape, and for
  /// the same reason, as `idempotencyKey` below.
  ///
  /// Issued from `ticket_number_counters`, never from `count(*)`; see that model.
  /// Both halves of the reference are parsed back out of inbound mail — see
  /// `parseTicketRef`, which has to accept this form AND `#id`, because every
  /// mail thread open today quotes the older one.
  number         String?               @unique
  subject        String
  description    String
  status         TicketStatus          @default(new)
  priority       Priority              @default(medium)
  requesterId    Int                   @map("requester_id")
  requester      User                  @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId     Int?                  @map("assignee_id")
  assignee       User?                 @relation("TicketAssignee", fields: [assigneeId], references: [id])
  categoryId     Int                   @map("category_id")
  /// The tenant match is enforced by the database, exactly as it is for
  /// `project` below: a composite foreign key on (category_id, customer_id), so
  /// a ticket can never point at another customer's category.
  ///
  /// This became both possible and necessary in the same change. Possible,
  /// because `categories.customer_id` stopped being nullable — a shared category
  /// belonged to no customer, so there was nothing to match against. Necessary,
  /// because the service-layer rule "a ticket's project and category must name
  /// the same tenant" is otherwise one forgotten check away from being false,
  /// and it costs nothing on read.
  ///
  /// Declared HERE rather than as raw SQL in the migration, unlike the partial
  /// indexes: `prisma migrate diff` reports a foreign key it does not know about
  /// as drift and proposes dropping it. See backend/CLAUDE.md.
  category       Category              @relation(fields: [categoryId, customerId], references: [id, customerId], onDelete: Restrict)
  /// What the problem actually is, when the category is "Other".
  ///
  /// Deliberately a column on the TICKET rather than a new category row. Left to
  /// create rows, free text makes "เน็ตช้า" and "เน็ทช้า" two categories that
  /// mean one thing, and every report grouping by category splits in half
  /// without anyone noticing. Promoting a recurring one into a real category is
  /// a person's decision, taken while looking at all of them at once.
  ///
  /// Nullable in the database and required in the domain, for two different
  /// reasons that both have to hold. Nullable because every ticket filed before
  /// this existed has none and must still open; required because the rule is
  /// about a category CODE, and a CHECK constraint here could only see
  /// `category_id` — an id whose meaning differs per tenant. The rule lives in
  /// shared/category-other.ts and is enforced at the one place tickets are
  /// written.
  categoryOther  String?               @map("category_other")
  /// Which project this ticket belongs to, if any.
  ///
  /// Nullable and staying that way. Not a column waiting to be tightened: mail
  /// and CSV arrive naming no project, a customer may run none at all, and the
  /// tickets raised before this column existed have no project anyone can
  /// honestly infer. Requiring it in the web form is a rule for that one path
  /// and belongs in its validator, not here, where it would break intake.
  ///
  /// A project only ROUTED a ticket before this: the assignee was read from the
  /// requester's project at creation and nothing recorded which one. So moving
  /// someone between projects silently rewrote where their past work appeared
  /// to have come from — this column is what fixes that.
  ///
  /// The tenant match is enforced in the database, not by convention: the
  /// migration adds a composite foreign key on (project_id, customer_id) so a
  /// ticket can never point at another customer's project. Prisma cannot
  /// express that, so it lives in raw SQL beside this relation.
  projectId      Int?                  @map("project_id")
  project        Project?              @relation(fields: [projectId, customerId], references: [id, customerId], onDelete: Restrict)
  // Tenant boundary (= the requester's customer). Required, unlike users.customerId:
  // a user with no customer is platform staff, but a TICKET with no customer is
  // unreachable — ticketScopeWhere matches staff on customerId equality, so a null
  // hides the row from every customer-bound admin. Enforced here rather than by
  // convention in the create path, which let 12 such rows through (see
  // 20260804044000_backfill_ticket_customer_from_requester).
  customerId     Int                   @map("customer_id")
  customer       Customer              @relation(fields: [customerId], references: [id])
  dueAt          DateTime?             @map("due_at") // computed from SLA policy at creation
  resolvedAt     DateTime?             @map("resolved_at") // set when it first reaches resolved; drives SLA met/breached
  /// What the desk did about it, written when the work is declared finished.
  ///
  /// Nullable in the database and required in the domain, the same split
  /// `categoryOther` makes and for the same first reason: every ticket closed
  /// before this column existed has none and must still open. The second reason
  /// differs — the rule is about the MOVE, not the row. `new → pending` and
  /// `new → closed` must carry one; `pending → closed` must not, because the
  /// requester confirming and the 72h sweep are not the ones who did the work.
  /// A CHECK constraint here can only see the row it is written on, never which
  /// transition put it there, so the rule lives in `requiresResolution` in
  /// shared/ticket-status.ts and is enforced at the one place status is written.
  ///
  /// A reopen keeps whatever is here rather than clearing it: the ticket that
  /// comes back is the same ticket, and the account of what was tried last time
  /// is the most useful thing the person picking it up can read. Finishing it
  /// again overwrites this with the new answer.
  resolution     String?               @map("resolution")
  closedAt       DateTime?             @map("closed_at")
  // Soft delete, super-admin only. The normal end of a ticket's life is `closed`,
  // which keeps it in the history log; this is the escape hatch for a row that
  // should never have existed (spam, a mis-filed import). The row and its history
  // stay on disk — `ticketScopeWhere` filters it out of every read.
  deletedAt      DateTime?             @map("deleted_at")
  // De-duplication key for the create request, from the `Idempotency-Key`
  // header. Null for every ticket raised without one — CSV import, email
  // intake, an older client — and many nulls per requester are fine, which is
  // why this is a nullable unique rather than a required one.
  //
  // Scoped to the requester, NOT globally unique: the key is minted client-side
  // with no coordination, so two people can pick the same string, and a global
  // constraint would hand one person's ticket back to the other as a "replay".
  idempotencyKey String?               @map("idempotency_key")
  // Problem this incident is linked to (many tickets → one problem). Optional.
  problemId      Int?                  @map("problem_id")
  problem        Problem?              @relation(fields: [problemId], references: [id])
  statusHistory  TicketStatusHistory[]
  comments       Comment[]
  attachments    Attachment[]
  reads          TicketRead[]
  queuedEmails   EmailOutbox[]
  // Who/what is affected. Deliberately separate from `requester` — the person
  // who reports a ticket is often not the person or machine impacted by it.
  // Both are optional and manually chosen; nothing is inferred from the session.
  affectedUsers  TicketAffectedUser[]
  affectedAssets TicketAffectedAsset[]
  /// The raw form submission this ticket was opened from, if it came that way.
  /// Kept as its own row rather than folded in here so that a PDPA erasure can
  /// take the personal data the sender typed without taking the ticket the desk
  /// worked — see `IntakeSubmission`.
  intake         IntakeSubmission?
  /// Which surface this ticket arrived through.
  ///
  /// Nullable and deliberately NOT backfilled. Every ticket that predates this
  /// column came in through one of three doors and the row does not record which,
  /// so any value written for them would be a guess that reports would then read
  /// as a fact. NULL says "not recorded", which is the only true thing available.
  ///
  /// Today the intake path is the only writer, so a non-null value means exactly
  /// `web_intake`. The other three values are in the enum because they are what
  /// the column MEANS, and the paths that would write them (the app's own form,
  /// mail intake, the spreadsheet import) are not part of this change.
  channel        TicketChannel?
  /// When the problem was reported, as opposed to when this row was written.
  ///
  /// They are the same moment for a ticket raised in the app, and they are not
  /// for one that arrived another way: the intake form stamps the browser's
  /// `submittedAt`, so a submission that queued behind a retry is dated when the
  /// person sent it rather than when the server got round to it.
  ///
  /// Backfilled from `created_at` on the rows that predate it, which is not a
  /// guess — for an in-app ticket the two really were the same instant. That is
  /// what makes it safe for this one to be NOT NULL while `channel` above stays
  /// nullable, and it is the whole difference between the two: one had a true
  /// value available and the other did not.
  reportedAt     DateTime              @default(now()) @map("reported_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  // What makes a repeated create idempotent: the second insert loses on this
  // constraint instead of producing a second ticket, and the loser answers with
  // the row that won. Doing it with a constraint rather than a check-then-insert
  // is deliberate — two requests in flight together would both pass the check.
  @@unique([requesterId, idempotencyKey])
  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([problemId])
  // The closed-ticket history log filters on a closedAt range and orders by it.
  @@index([closedAt])
  // Every read pairs the tenant filter with `deletedAt IS NULL` (ticketScopeWhere),
  // so the two travel together rather than as two separate indexes.
  @@index([customerId, deletedAt])
  // "Which tickets came from the form" — the triage queue's own filter, and the
  // one dimension the new channel adds to reporting.
  @@index([channel])
  @@map("tickets")
}

// Per-user read pointer for a ticket's chat: the id of the last comment the user
// has seen. Drives read receipts — a message is "read" once another participant's
// pointer reaches it. One row per (ticket, user); the pointer only moves forward.
model TicketRead {
  ticketId          Int      @map("ticket_id")
  ticket            Ticket   @relation(fields: [ticketId], references: [id])
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  lastReadCommentId Int      @map("last_read_comment_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@id([ticketId, userId])
  @@map("ticket_reads")
}

// SLA source of truth: one row per status change (append-only).
model TicketStatusHistory {
  id          Int                 @id @default(autoincrement())
  ticketId    Int                 @map("ticket_id")
  ticket      Ticket              @relation(fields: [ticketId], references: [id])
  fromStatus  TicketStatusRecord? @map("from_status")
  toStatus    TicketStatusRecord  @map("to_status")
  changedById Int?                @map("changed_by_id")
  changedBy   User?               @relation(fields: [changedById], references: [id])
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_status_history")
}

// Ticket conversation: public replies + internal notes (agent-only). Soft
// delete via `deletedAt` — comments are the one entity that can be removed.
model Comment {
  id          Int            @id @default(autoincrement())
  ticketId    Int            @map("ticket_id")
  ticket      Ticket         @relation(fields: [ticketId], references: [id])
  authorId    Int            @map("author_id")
  author      User           @relation(fields: [authorId], references: [id])
  body        String
  internal    Boolean        @default(false)
  // Channel this message arrived on. Web and email messages share one thread —
  // `channel` is presentation metadata, never a filter on the conversation.
  channel     CommentChannel @default(web)
  // RFC 5322 Message-ID, stored for both directions: set on outbound replies we
  // send, and on inbound mail we thread. Lets a future upgrade match replies by
  // In-Reply-To/References header without another migration.
  messageId   String?        @unique @map("message_id")
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  /// Files sent with this message. The thread draws these inside the bubble;
  /// files attached to the ticket without a message are not here.
  attachments Attachment[]

  @@index([ticketId])
  @@map("comments")
}

// File attachments on a ticket. Bytes live in IFileStorage (local/S3); only
// metadata + the storage key are in the DB.
model Attachment {
  id              Int                   @id @default(autoincrement())
  ticketId        Int                   @map("ticket_id")
  ticket          Ticket                @relation(fields: [ticketId], references: [id])
  // The message this file was sent with, so the thread can draw it inside that
  // bubble. Nullable, and it has to be: a file added from the sidebar belongs to
  // the ticket and to no message, and every row written before this column
  // existed is in the same position. A null means "show it in the sidebar only",
  // never "orphaned".
  commentId       Int?                  @map("comment_id")
  comment         Comment?              @relation(fields: [commentId], references: [id])
  uploaderId      Int                   @map("uploader_id")
  uploader        User                  @relation(fields: [uploaderId], references: [id])
  /// The name the uploader's own machine had. Kept verbatim, shown on hover, and
  /// never used to build a path — see `storageKey` below.
  filename        String
  /// The name the app shows and downloads as: `T<ticket>-<seq>-<slug>.<ext>`.
  ///
  /// Nullable only so the column could be added without inventing values in SQL.
  /// The slug rules (Thai kept, 40-char cut, 100-char cap, sequence widening)
  /// live in one TypeScript function, and expressing them a second time in a
  /// migration would be two implementations of one rule that could drift.
  /// `prisma/backfill-display-names.ts` fills the old rows using that same
  /// function; every row written since carries it.
  displayName     String?               @map("display_name")
  contentType     String                @map("content_type")
  sizeBytes       Int                   @map("size_bytes")
  /// Opaque object key. Random + a extension verified from the file's own magic
  /// bytes — no part of it comes from user input, and it carries no ticket id.
  storageKey      String                @map("storage_key")
  /// Key of the 800px-wide copy the thread loads. Null when the image was
  /// already small enough, or when resizing failed — the reader falls back to
  /// the full file, which is why a failed resize never fails an upload.
  thumbKey        String?               @map("thumb_key")
  /// Intrinsic pixel size of the ORIGINAL, so the thread can reserve the box
  /// before the bytes arrive. Null for non-images and for rows that predate it.
  width           Int?
  height          Int?
  /// The public-form submission this file arrived with, when it came that way.
  ///
  /// Beside `ticketId` rather than instead of it, because they answer different
  /// questions and a PDPA erasure needs both: the ticket is where the desk sees
  /// the file, and the submission is the unit the retention rule deletes.
  submissionId    Int?                  @map("submission_id")
  submission      IntakeSubmission?     @relation(fields: [submissionId], references: [id])
  /// SHA-256 of the bytes as received. Nullable for rows written before it was
  /// computed; a null means "not recorded", never "no checksum matched".
  checksum        String?
  /// Where this file stands with the virus scanner. NULL for every file that was
  /// never subject to scanning — see `AttachmentScanStatus`, which explains why
  /// that is a different fact from `clean`.
  scanStatus      AttachmentScanStatus? @map("scan_status")
  /// When the scanner last answered. Null while `scanStatus` is `pending`, and
  /// for the rows that were never scanned at all.
  scannedAt       DateTime?             @map("scanned_at")
  /// Which storage backend holds `storageKey`. Null = decided by the env driver,
  /// which is what every existing row relies on; see `StorageProvider`.
  storageProvider StorageProvider?      @map("storage_provider")
  createdAt       DateTime              @default(now()) @map("created_at")

  // One display name per ticket, enforced by the database rather than hoped for.
  // The sequence is derived from how many files the ticket already has, and two
  // uploads racing can read the same count — so the write is what settles it:
  // the loser gets a unique violation and retries with the next number. Nulls do
  // not collide in Postgres, so this is satisfied by every row that predates the
  // column too.
  @@unique([ticketId, displayName])
  @@index([ticketId])
  @@index([commentId])
  @@index([submissionId])
  // The scanner's own work queue: the files still waiting on a verdict.
  @@index([scanStatus])
  @@map("attachments")
}

/// One submission of the public intake form, exactly as it arrived.
///
/// A separate row from the `Ticket` it opens, and that separation is the point
/// rather than normalisation for its own sake. Three things follow from it:
///
///   1. **PDPA erasure has something to delete.** A request to remove a person's
///      data can take this row, its consent log and its files while leaving the
///      ticket the desk actually worked — which is a record of the desk's own
///      activity, not of the sender.
///   2. **Spam is recorded without a ticket.** A submission the honeypot caught
///      has `ticketId` NULL: nothing entered the queue and nobody was mailed, but
///      the evidence is on disk, because the only way to know whether a honeypot
///      is catching bots or customers is to look at what it caught.
///   3. **What the sender typed survives triage.** The desk retitles, recategorises
///      and reassigns; this row still says what was submitted, which is what an
///      audit of "did we answer what they asked" needs.
///
/// Everything here is attacker-supplied and is stored after validation and
/// length-capping, never trusted on read.
model IntakeSubmission {
  id                Int          @id @default(autoincrement())
  /// The ticket this opened. NULL for `spam` only — see above. Unique because one
  /// submission opens at most one ticket, and a second row pointing at the same
  /// ticket would mean two people's data behind one case.
  ticketId          Int?         @unique @map("ticket_id")
  ticket            Ticket?      @relation(fields: [ticketId], references: [id])
  /// What the sender typed. `name`/`companyName` are display data and nothing is
  /// resolved from them; the email is what the customer match reads.
  name              String
  businessEmail     String       @map("business_email")
  companyName       String       @map("company_name")
  phone             String
  /// The service code the form offered (`rpa-consult`, …). Kept RAW and mapped to
  /// a category by code at write time, never stored as a category id: a category
  /// id means something different in every tenant, and this row may be read long
  /// after the ticket was moved to another one.
  service           String
  /// The body, capped at 2000 characters by the validator.
  message           String
  /// Which form sent this (`web-intake-form`). A string rather than an enum: it
  /// identifies a deployed page, and a second page appearing must not need a
  /// migration.
  source            String
  status            IntakeStatus
  /// The customer the email domain matched, if any — the reason this row is
  /// `linked` rather than `triage`. Recorded here because the TICKET cannot hold
  /// it: an unmatched ticket is filed under the triage tenant, so afterwards
  /// `tickets.customer_id` no longer distinguishes "matched that customer" from
  /// "nothing matched". Not a foreign key on purpose — it is a record of a
  /// decision taken at a moment in time, and an archived customer must not make
  /// the decision unreadable.
  matchedCustomerId Int?         @map("matched_customer_id")
  /// The sender used a free mailbox (gmail, hotmail, …). A flag for triage, never
  /// a refusal: plenty of small businesses have no domain of their own.
  isFreeMail        Boolean      @default(false) @map("is_free_mail")
  /// For the audit trail and for answering "where did this burst come from".
  /// Nullable because a proxy can leave us without either.
  ip                String?
  userAgent         String?      @map("user_agent")
  /// When the BROWSER says it was sent, and `createdAt` is when the server wrote
  /// it. Two columns because the gap between them is the only evidence of a slow
  /// or retried submission, and because `submittedAt` is client-supplied and must
  /// never be mistaken for a server fact.
  submittedAt       DateTime     @map("submitted_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  consents    ConsentLog[]
  attachments Attachment[]

  /// The rate limiter counts in memory; this is what answers "has this address
  /// written before, and how often" after a restart.
  @@index([businessEmail])
  /// The retention sweep's query: submissions of a given status, oldest first.
  @@index([status, createdAt])
  @@map("intake_submissions")
}

/// Evidence that somebody agreed to something, and to WHICH wording.
///
/// A log rather than a flag, and append-only like `ticket_status_history`: PDPA
/// asks what a person consented to and when, which a boolean on the submission
/// cannot answer once the wording has been edited. The text is snapshotted here
/// in full rather than referenced by version alone, so an answer survives the
/// notice page being rewritten or taken down.
///
/// Many rows per submission are allowed even though today's form writes exactly
/// one. A withdrawal, or a re-consent to new wording, is another event and belongs
/// beside the first rather than overwriting it — a consent record that can be
/// overwritten is not evidence of anything.
model ConsentLog {
  id             Int              @id @default(autoincrement())
  submissionId   Int              @map("submission_id")
  submission     IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// The exact wording shown, and the version label the page was serving. Both,
  /// because the label is how a lawyer refers to it and the text is what the
  /// person actually read.
  consentText    String           @map("consent_text")
  consentVersion String           @map("consent_version")
  /// Whether this event granted or withdrew. Always true from the form, which
  /// refuses to submit otherwise (422); the column exists so a withdrawal has
  /// somewhere truthful to go.
  granted        Boolean          @default(true)
  /// Captured with the event rather than read from the submission, because a
  /// later consent event can arrive from a different place entirely.
  ip             String?
  userAgent      String?          @map("user_agent")
  grantedAt      DateTime         @map("granted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([submissionId])
  @@map("consent_logs")
}

/// The daily sequence behind `tickets.number`. One row per day, holding the last
/// number issued for it.
///
/// A counter table rather than `count(*) + 1`, which is not a sequence but a
/// race: two requests counting at the same moment read the same total and both
/// claim the number after it. Issuance is a single statement —
/// `INSERT … ON CONFLICT (day) DO UPDATE SET seq = seq + 1 RETURNING seq` — so
/// Postgres serialises the two on the row lock and hands each a different answer.
/// No advisory lock is needed, and the unique index on `tickets.number` is the
/// belt behind the braces.
///
/// A Postgres sequence could not do this: sequences do not reset, and the number
/// resets every day by design. Nor could it be derived from `tickets` itself —
/// deleting a ticket would free its number to be issued twice.
///
/// Numbers are consumed by rolled-back transactions and never reused, exactly as
/// a sequence behaves. Gaps are correct: the alternative is two tickets sharing a
/// reference.
model TicketNumberCounter {
  /// The day the sequence belongs to, as `YYYYMMDD` in the server's timezone.
  /// A string because it is a LABEL that appears verbatim in the reference, not
  /// an instant — storing a date would invite a timezone conversion between
  /// issuing the number and printing it, and one hour's tickets would carry
  /// yesterday's date.
  day       String   @id
  /// The last number issued for that day. Starts at 1 on the day's first ticket.
  seq       Int
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ticket_number_counters")
}

// Per-user notifications, fired on ticket transitions and new comments.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  type      String
  ticketId  Int?      @map("ticket_id")
  message   String
  readAt    DateTime? @map("read_at")
  // Vestigial. This column made the table an email outbox until delivery moved
  // to `email_outbox`, which carries what a bell entry cannot: the recipient's
  // language, retry state, an RFC 5322 identity and a threading chain. NOTHING
  // READS IT any more — the migration stamped every pending row so no build of
  // the old sweep could double-send — and it is kept only so that dropping it is
  // a decision of its own rather than a side effect of this change.
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([emailedAt])
  @@map("notifications")
}

// Append-only audit trail — one row per mutation (create, status change, …).
/// What each role may do.
///
/// This used to be a constant in `shared/auth.ts` and is now a table, because a
/// super admin has to be able to change it without a deploy. What did NOT move
/// is the meaning of the strings: each one corresponds to a gate in code, so the
/// catalogue lives in `shared/permissions.ts` and this table only says who holds
/// what. A row naming a permission the catalogue does not define gates nothing.
///
/// `role` is the existing enum rather than a foreign key to a roles table.
/// Creating roles is deliberately out of scope: it would mean giving up the
/// Postgres enum on `users.role`, which every scope query compares against.
model RolePermission {
  role        Role
  permission  String
  /// Who granted it and when. The audit trail carries the full before/after of
  /// every edit; these two are here so a single row can answer "where did this
  /// come from" without a search.
  grantedById Int?     @map("granted_by_id")
  grantedBy   User?    @relation("RolePermissionGrantedBy", fields: [grantedById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([role, permission])
  @@index([role])
  @@map("role_permissions")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_logs")
}

// Asset registry — the things tickets are about (laptops, printers, servers…).
// Customer-scoped like every other tenant-owned row: `assetTag` is unique per
// customer, not globally, so two tenants may both run an "IT-0001".
model Asset {
  id         Int                   @id @default(autoincrement())
  assetTag   String                @map("asset_tag")
  name       String
  kind       AssetKind             @default(other)
  status     AssetStatus           @default(active)
  serial     String?
  location   String?
  // Person the asset is signed out to. Distinct from a ticket's affected users:
  // ownership is a property of the asset, not of any one ticket.
  ownerId    Int?                  @map("owner_id")
  owner      User?                 @relation("AssetOwner", fields: [ownerId], references: [id])
  customerId Int?                  @map("customer_id") // tenant; null = platform-wide
  customer   Customer?             @relation(fields: [customerId], references: [id])
  tickets    TicketAffectedAsset[]
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  @@unique([customerId, assetTag])
  @@index([customerId])
  @@map("assets")
}

// Join: users affected by a ticket (many per ticket, all optional).
model TicketAffectedUser {
  ticketId  Int      @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@id([ticketId, userId])
  @@index([userId])
  @@map("ticket_affected_users")
}

// Join: assets affected by a ticket (many per ticket, all optional).
model TicketAffectedAsset {
  ticketId  Int      @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assetId   Int      @map("asset_id")
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([ticketId, assetId])
  @@index([assetId])
  @@map("ticket_affected_assets")
}

// An underlying cause behind one or more incident tickets. Created either by
// linking an existing problem to a ticket, or by converting a ticket into a new
// problem (which links the source ticket as the first affected incident).
model Problem {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  status      ProblemStatus @default(investigating)
  rootCause   String?       @map("root_cause")
  workaround  String?
  // The knowledge-base article documenting this known error, e.g. "KB-042".
  //
  // A SOFT reference, still on purpose. `kb_articles` is now a real table with a
  // matching String id, so this COULD be a foreign key — and is deliberately not.
  // A real FK would have to either refuse to delete an article a problem cites or
  // null the citation out; both are worse than what this does, which is keep the
  // id and resolve it to null so the UI can say the article is gone. Articles are
  // reference material that gets retired; the problem that cited one is a record
  // of what happened and outlives it.
  //
  // Because there is no FK, the API validates the id on write (kbService.exists)
  // and resolves it on read (kbService.referencesFor) — that pair is what keeps a
  // dangling reference from ever being STORED, while tolerating one that goes
  // stale afterwards.
  kbArticleId String?       @map("kb_article_id")
  customerId  Int?          @map("customer_id") // tenant; inherited from the source ticket
  customer    Customer?     @relation(fields: [customerId], references: [id])
  createdById Int?          @map("created_by_id")
  createdBy   User?         @relation("ProblemCreatedBy", fields: [createdById], references: [id])
  tickets     Ticket[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("problems")
}

/**
 * Whether an article is visible to everyone or still being written. Reads are
 * filtered on it: anyone signed in sees `published`, and only someone who may
 * write articles also sees `draft`.
 */
enum KbStatus {
  draft
  published
}

/**
 * A knowledge-base article.
 * The id is a human-readable code (`KB-042`), not an autoincrement, and that is
 * load-bearing rather than decorative: `problems.kb_article_id` already stores
 * these strings as a soft reference, so keeping the shape means every existing
 * link keeps resolving and no row of `problems` has to be rewritten. It is also
 * the id support staff say out loud.
 * No `customerId`. Every tenant-scoped table here carries one and the spec's
 * `kb_articles` deliberately does not — an article about resetting a password is
 * the same article for everyone, which is also how the static dataset this
 * replaces behaved.
 */
model KbArticle {
  id           String   @id
  title        String
  /**
   * One-paragraph summary, shown in the browse list without loading the body.
   */
  excerpt      String
  /**
   * Markdown-lite: "## " headings, "- " bullets, blank line = new block.
   */
  body         String
  /// What this article is ABOUT, as a cross-tenant code rather than a pointer at
  /// one customer's category row.
  ///
  /// It was `categoryId` until categories became per-customer. That change would
  /// have made the knowledge base tenant-scoped by accident: every article would
  /// have ended up owned by whichever customer inherited the shared row it
  /// pointed at, and one article about resetting a password serves every tenant —
  /// which is also why `KbArticle` has no `customerId` of its own and never did.
  ///
  /// So the article names the SUBJECT, and each tenant's own category carries the
  /// same code. Nothing here belongs to anybody, which is the point.
  categoryCode String   @map("category_code")
  tags         String[]
  /**
   * Rough reading time in minutes, written by the author rather than computed.
   */
  readMin      Int      @map("read_min")
  status       KbStatus @default(published)
  /**
   * Who wrote it. Nullable because the articles that seeded this table predate
   * the notion of an author, and `SetNull` because retiring the person who wrote
   * an article must not take the article with them.
   */
  authorId     Int?     @map("author_id")
  author       User?    @relation("KbAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([categoryCode])
  @@index([status])
  @@map("kb_articles")
}

/// One outbound email, queued rather than sent.
///
/// This is a transactional outbox, the same pattern `notifications.emailed_at`
/// used before it: a row is written inside the mutation's own transaction and a
/// background sweep delivers it. Nothing is mailed for work that later rolls
/// back, network I/O stays off the request path, and a failed send is simply a
/// row that is still pending — the user's action never fails because a mail
/// server did.
///
/// It is a table of its own rather than more columns on `notifications` because
/// the two have different lifetimes and different audiences. A notification is
/// one person's bell entry, read once and done; an email carries retry state,
/// an RFC 5322 identity, and a threading chain, and it must survive as the
/// delivery record the Activity log reads. Notifications stay exactly what they
/// were.
model EmailOutbox {
  id       Int    @id @default(autoincrement())
  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  /// The domain event this mail announces (`ticket.created`, `comment.public`,
  /// …). Half of the idempotency key, and what the per-event on/off switch and
  /// the template lookup both key on.
  eventType String @map("event_type")

  /// The row that CAUSED this mail — a comment id, a status-history id, or the
  /// ticket id for events that have no record of their own. Non-nullable on
  /// purpose: Postgres treats NULLs as distinct in a unique constraint, so a
  /// nullable column here would silently let the duplicate it exists to prevent
  /// straight through.
  sourceRecordId Int @map("source_record_id")

  recipientUserId Int  @map("recipient_user_id")
  recipient       User @relation(fields: [recipientUserId], references: [id])

  /// Snapshotted at queue time, not read from the user at send time: the address
  /// and language we DECIDED to write to. A person who changes either between
  /// queueing and delivery still receives the mail that was composed for them,
  /// and the log records where it actually went.
  recipientEmail String   @map("recipient_email")
  lang           Language

  /// Everything the template needs, frozen at the moment of the event: the
  /// ticket's state, the message that triggered the mail, who did it. Rendered
  /// from this rather than re-read at send time, so a mail describes the event
  /// it announces and not the ticket's later state.
  payload Json

  status   EmailOutboxStatus @default(pending)
  attempts Int               @default(0)

  /// When the sweep may next try. Moves out on each failure (exponential
  /// backoff), which is what stops a dead provider from being hammered once a
  /// minute by every queued mail at once.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")

  /// RFC 5322 identity of the mail as sent, and the chain that threads it.
  /// `inReplyTo`/`referencesHeader` point at earlier mail in the SAME
  /// (ticket, recipient) conversation — per recipient rather than per ticket, so
  /// a chain never references a message that person was never sent.
  messageId        String? @unique @map("message_id")
  inReplyTo        String? @map("in_reply_to")
  referencesHeader String? @map("references_header")

  /// Why nothing was sent. Set with `suppressed` (no address, event disabled,
  /// no queue team to escalate to) — the difference between a decision and a
  /// failure, which `error` records instead.
  suppressedReason String?   @map("suppressed_reason")
  error            String?
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  /// The idempotency key from the spec: one mail per (ticket, event, cause,
  /// recipient). Enforced as a constraint rather than a check-then-insert
  /// because two requests in flight together would both pass the check — the
  /// same reasoning as `tickets.idempotency_key`.
  @@unique([ticketId, eventType, sourceRecordId, recipientUserId])
  /// The sweep's own query: pending rows whose backoff has elapsed, oldest first.
  @@index([status, nextAttemptAt])
  /// Finding the previous mail in a conversation to thread onto.
  @@index([ticketId, recipientUserId])
  @@map("email_outbox")
}
