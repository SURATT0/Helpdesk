# Deskly API environment
PORT=4000
NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# CORS origin for the Next.js web app
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (tickets repository runs on this; see docker-compose.yml)
DATABASE_URL=postgresql://deskly:deskly@localhost:5432/deskly?schema=public

# Storage adapter: "local" (dev) or "s3" (prod / S3-compatible like MinIO)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.uploads
# S3 settings (only used when STORAGE_DRIVER=s3). S3_BUCKET is required.
# For real AWS S3, set S3_REGION and leave endpoint/keys unset to use the IAM
# credential chain. For MinIO/S3-compatible, set S3_ENDPOINT + path-style + keys.
# S3_BUCKET=deskly-attachments
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_URL=https://cdn.example.com   # optional; else s3://bucket/key

# Auth secrets. The values below are DEV FALLBACKS — fine for `npm run dev`, but
# with NODE_ENV=production the API refuses to boot unless both are set, unique,
# not these defaults, and >=32 chars. Generate real ones: `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800
# Refresh-cookie Secure flag. Leave unset to follow NODE_ENV (on in production).
# Set false when running production mode without TLS (e.g. docker-compose over HTTP).
# COOKIE_SECURE=false
# Max login attempts per IP per 15-min window (brute-force guard)
AUTH_RATE_LIMIT=20

# Log aggregation. Structured JSON always goes to stdout; set LOKI_URL to ALSO
# ship logs to a Grafana Loki endpoint (basic-auth optional, e.g. Grafana Cloud).
# Leave unset for stdout only. See docker-compose.logging.yml for a local stack.
# LOKI_URL=http://localhost:3100
# LOKI_USERNAME=
# LOKI_PASSWORD=

# External ticket sources (future integrations). Each is a pluggable adapter
# under src/modules/integrations; unset = provider shows as "not configured".
# The Jira/Zendesk REST calls are stubbed until implemented. A built-in "mock"
# source needs no config and is always available for demoing the sync pipeline.
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@your-org.com
# JIRA_API_TOKEN=            # https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_JQL=project = SUP AND status != Done
# ZENDESK_SUBDOMAIN=your-org # -> https://your-org.zendesk.com
# ZENDESK_EMAIL=you@your-org.com
# ZENDESK_API_TOKEN=

# Email-to-ticket (webhook / push). Set EMAIL_WEBHOOK_SECRET to enable the
# inbound endpoint POST /api/v1/integrations/email-inbound — point your email
# provider's inbound-parse route (SendGrid/Mailgun/Postmark) at it and have it
# send the secret in the `x-webhook-secret` header (or `?secret=`). Unknown
# senders become requester users unless EMAIL_CREATE_UNKNOWN_REQUESTER=false.
#
# EMAIL_DEFAULT_CUSTOMER is REQUIRED to accept mail from unknown senders: it names
# the tenant they are filed under (exact customer name, case-insensitive). There is
# no fallback — a ticket with no customer is invisible to every agent and manager —
# so if it is unset, mail from an unknown sender is refused instead.
# EMAIL_WEBHOOK_SECRET=change-me-long-random
# EMAIL_DEFAULT_CATEGORY=Email
# EMAIL_DEFAULT_CUSTOMER=Acme Corp
# EMAIL_CREATE_UNKNOWN_REQUESTER=true

# Email-to-ticket (IMAP / pull). Scaffolded adapter — unset = "not configured".
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=helpdesk@example.com
# IMAP_PASSWORD=
# IMAP_TLS=true

# Outbound SMTP. Unset = a "log" transport records each message instead of
# sending it, so the whole flow works in dev without a mail server. Set these to
# send real mail via nodemailer.
#
# To see real messages locally, start the mail catcher and point at it:
#   docker compose --profile mail up -d mailpit    -> inbox at localhost:8025
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465 (implicit TLS)
# SMTP_USER=helpdesk@example.com
# SMTP_PASSWORD=
# SMTP_FROM is the desk's own address: the From on every outbound mail, and the
# Reply-To that brings a reply back through the inbound webhook onto its ticket.
# Leaving it unset means replies land in an individual's mailbox instead.
# SMTP_FROM=Deskly Support <helpdesk@example.com>

# Background sweeps. All run on boot and then on an interval; set any to false to
# turn it off (SLA_ALERTS controls whether the sweep PUSHES an alert, not what
# counts as at risk — the window that decides both the alert and the badge is the
# customer's `slaWarnMs`; and SESSION_SWEEP does not affect when sessions expire,
# only when the dead rows are cleared).
# AUTO_CLOSE=true            # close tickets left resolved > 72h, hourly
# SLA_ALERTS=true            # notify on SLA nearing/past due, every 15 min
# SESSION_SWEEP=true         # delete expired refresh tokens, hourly

# Outbound ticket email. Events are queued into `email_outbox` inside the
# transaction that caused them, and a sweep delivers them every 60s.
#
# Off keeps everything queued but undelivered — nothing is lost and the Activity
# log still shows what would have gone out. With SMTP_HOST unset the adapter
# logs instead of sending, so nothing leaves the box either way.
# NOTIFICATION_EMAILS=true   # master switch for the delivery sweep
#
# Everything below is now a DEPLOYMENT DEFAULT. A customer with no policy of
# their own follows these; one that has saved settings (Settings → Notifications,
# super admin only) overrides them, and resetting their policy puts them back on
# these values — including any change you make here afterwards.
#
# Per-event switches. A DENY list, so a newly added event works without a config
# change — only turning one OFF needs one. Comma-separated event types:
#   ticket.created  comment.public_reply  ticket.pending
#   ticket.auto_close_reminder  ticket.closed  ticket.assigned
#   comment.requester_replied  ticket.closure_rejected  comment.internal_note
#   ticket.sla_warning  ticket.sla_breach
#   queue.ticket_unassigned  queue.requester_replied
# TICKET_EMAIL_DISABLED_EVENTS=ticket.sla_warning,queue.requester_replied
#
# Anti-spam: more than this many mails to one person about one ticket inside the
# window collapses into a single "several updates" summary.
# EMAIL_RATE_LIMIT_PER_TICKET=3
# EMAIL_RATE_WINDOW_MS=300000
#
# Delivery attempts before a message is given up on, and the backoff base.
# Attempt N waits base * 5^(N-1) — 1m, 5m, 25m by default.
# EMAIL_MAX_ATTEMPTS=3
# EMAIL_BACKOFF_BASE_MS=60000
# EMAIL_BATCH_LIMIT=100
#
# How long before the 72h auto-close the requester is warned that silence will
# close their ticket.
# EMAIL_AUTO_CLOSE_REMINDER_LEAD_MS=86400000

# Real-time event bus for the SSE comment stream. Unset = in-process (single
# node). Set a Redis URL to fan events out across multiple API instances via
# Redis pub/sub (required when running more than one API replica). The client
# reconnects with capped backoff and re-subscribes automatically.
# REDIS_URL=redis://redis:6379
# Production TLS + auth. Use a rediss:// URL (TLS auto) or set REDIS_TLS=true to
# force TLS over a redis:// URL. Credentials can live in the URL
# (redis://user:pass@host) or here. Keep cert verification ON in production.
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=true
# REDIS_TLS_REJECT_UNAUTHORIZED=true
