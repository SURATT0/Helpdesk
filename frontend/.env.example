# Where the WEB SERVER finds the API. A server-to-server address that the
# browser never sees, so `localhost` is right here even when the app is reached
# from a phone or through a tunnel. The Next server proxies /api/v1/* to it (the
# rewrite in next.config.mjs), which is why the browser only ever calls the
# origin it loaded the page from. Read at build time — `next build` bakes it.
API_PROXY_TARGET=http://localhost:4000

# Where the BROWSER finds the API. Unset (the default) means `/api/v1` —
# same-origin, through the proxy above, so one address serves the whole app and
# there is no CORS or cross-site cookie to arrange. Set it only to send the
# browser straight to an API on another host, bypassing the proxy; the API's
# WEB_ORIGIN must then list this app's origin. Must include the /api/v1 prefix,
# and is inlined into the client bundle at build time (NEXT_PUBLIC_).
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# The demo account the login screen offers one-click sign-in for.
#
# BOTH unset — the default, and what a real deployment wants — removes the demo
# button and the hint under it entirely. Set them only for a demo build, and set
# them TOGETHER: the password must be the one the seed actually ran with
# (backend SEED_PASSWORD), or the button signs in with the wrong one.
#
# The password used to be a literal in the login page, which stopped being true
# the day the seed took its own from the environment and generated one when that
# was unset — so the screen advertised a password that was not the password.
#
# Inlined into the client bundle at build time (NEXT_PUBLIC_), so changing it
# needs a rebuild. That is deliberate: whether an installation is a demo is a
# property of the build, not a switch on a live one. Never point these at a real
# account, and never commit a real password here.
# NEXT_PUBLIC_DEMO_EMAIL=dana.reyes@acme.com
# NEXT_PUBLIC_DEMO_PASSWORD=password123
